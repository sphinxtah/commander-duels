CD_ENVIRONMENT=development
CD_DATABASE_URL=postgresql+psycopg://commander:commander@127.0.0.1:5432/commander
CD_ENGINE_URL=http://localhost:8090
CD_PUBLIC_URL=http://localhost:5173
CD_LOG_LEVEL=INFO
CD_WORKER_POLL_SECONDS=5
# Google sign-in: a Web OAuth client ID with this site's origin as an authorized JavaScript
# origin (for local work, http://localhost and http://localhost:5173). Empty disables it.
CD_GOOGLE_CLIENT_ID=
# open: a first sign-in creates an active player. approval: it waits for an administrator.
CD_SIGNUP_POLICY=open
# SysOp's entrance exists only for these networks (comma-separated CIDRs); empty disables it.
# Use the production network's CIDR in deployment. Never include a trusted proxy.
CD_SYSOP_NETWORKS=127.0.0.1/32,::1/128
# Proxies whose X-Forwarded-For is believed. Vite's development proxy sends none.
CD_TRUSTED_PROXIES=
# Browsers keep Secure cookies on http://localhost; set false only for plain-HTTP hosts.
CD_COOKIE_SECURE=true
# Shared by the API and the engine (at least 32 random characters); only requests carrying it
# reach the engine's service games. Empty turns games off. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CD_ENGINE_SERVICE_TOKEN=
# Games one account may run at once (SysOp is not limited), and games the API runs in total.
CD_GAMES_PER_ACCOUNT=1
CD_GAMES_MAX=2
# Compose only: the host port PostgreSQL is published on. Move it if Windows reserved 5432.
CD_DB_PORT=5432

 public class TargetDefender extends TargetPermanentOrPlayer {
 
+    // Commander Duels: the defenders the combat names, which this choice is among
+    private final Set<UUID> defenders;
+
     public TargetDefender(Set<UUID> defenders) {
         super(1, 1, new FilterDefender(defenders), true);
+        this.defenders = new LinkedHashSet<>(defenders);
     }
 
     private TargetDefender(final TargetDefender target) {
         super(target);
+        this.defenders = new LinkedHashSet<>(target.defenders);
+    }
+
+    /**
+     * Commander Duels: the choice is among the combat's defenders, which the game's attack rules
+     * have already named (Combat.setDefenders, Game.attackablePlayers). In most games those are in
+     * the attacking player's range of influence, so nothing changes there. A game with its own
+     * attack rules may name a player outside that range (the Emperor variant with a house rule), and
+     * that player, their planeswalkers and the battles they protect must still be offered: so this
+     * does not ask for range a second time, as TargetPermanentOrPlayer does, and offers every named
+     * defender that is still there.
+     */
+    @Override
+    public Set<UUID> possibleTargets(UUID sourceControllerId, Ability source, Game game) {
+        Set<UUID> possibleTargets = new LinkedHashSet<>();
+        for (UUID defenderId : defenders) {
+            if (isThere(defenderId, sourceControllerId, source, game)) {
+                possibleTargets.add(defenderId);
+            }
+        }
+        return keepValidPossibleTargets(possibleTargets, sourceControllerId, source, game);
+    }
+
+    @Override
+    public boolean canChoose(UUID sourceControllerId, Ability source, Game game) {
+        return countThere(sourceControllerId, source, game) >= this.minNumberOfTargets;
+    }
+
+    @Override
+    public boolean canChoose(UUID sourceControllerId, Game game) {
+        return countThere(sourceControllerId, null, game) >= this.minNumberOfTargets;
+    }
+
+    private int countThere(UUID sourceControllerId, Ability source, Game game) {
+        int count = 0;
+        for (UUID defenderId : defenders) {
+            if (isThere(defenderId, sourceControllerId, source, game)) {
+                count++;
+            }
+        }
+        return count;
+    }
+
+    private boolean isThere(UUID defenderId, UUID sourceControllerId, Ability source, Game game) {
+        Player player = game.getPlayer(defenderId);
+        if (player != null) {
+            return player.isInGame() && filter.match(player, sourceControllerId, source, game);
+        }
+        Permanent permanent = game.getPermanent(defenderId);
+        return permanent != null && permanent.isPhasedIn()
+                && filter.match(permanent, sourceControllerId, source, game);
     }
 
     @Override

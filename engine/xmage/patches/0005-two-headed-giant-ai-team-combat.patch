+    /** 805.10d: with shared team turns, the defending team blocks together. */
+    private static List<Permanent> defendingTeamBlockers(Player defender, Game game) {
+        List<Permanent> blockers = defender.getAvailableBlockers(game);
+        for (UUID teammateId : game.getTeammates(defender.getId())) {
+            Player teammate = game.getPlayer(teammateId);
+            if (teammate != null && teammate.isInGame()) {
+                blockers = new ArrayList<>(blockers);
+                blockers.addAll(teammate.getAvailableBlockers(game));
+            }
+        }
+        return blockers;
+    }
+
+    /**
+     * 805.10b: with shared team turns, the attack is the active team's. The creatures that will attack
+     * with this player's: its teammates' already attacking and, while they have yet to declare (the
+     * turn's holder declares first), the ones they could attack with. Just this player's outside team
+     * games.
+     */
+    private List<Permanent> teamAttackers(List<Permanent> attackers, UUID defenderId, Game game) {
+        Set<UUID> teammates = game.getTeammates(playerId);
+        if (teammates.isEmpty()) {
+            return attackers;
+        }
+        List<Permanent> team = new ArrayList<>(attackers);
+        boolean teammatesToDeclare = playerId.equals(game.getState().getActivePlayerId());
+        for (UUID teammateId : teammates) {
+            Player teammate = game.getPlayer(teammateId);
+            if (teammate == null || !teammate.isInGame()) {
+                continue;
+            }
+            for (UUID attackerId : game.getCombat().getAttackers()) {
+                Permanent attacker = game.getPermanent(attackerId);
+                if (attacker != null && attacker.isControlledBy(teammateId)) {
+                    team.add(attacker);
+                }
+            }
+            if (teammatesToDeclare) {
+                teammate.getAvailableAttackers(defenderId, game).stream()
+                        .filter(attacker -> !team.contains(attacker))
+                        .forEach(team::add);
+            }
+        }
+        return team;
+    }
+

diff --git a/Mage/src/main/java/mage/game/events/TeamStepEvent.java b/Mage/src/main/java/mage/game/events/TeamStepEvent.java
new file mode 100755
index 00000000..8660e997
--- /dev/null
+++ b/Mage/src/main/java/mage/game/events/TeamStepEvent.java
@@ -0,0 +1,55 @@
+package mage.game.events;
+
+import mage.game.Game;
+import mage.players.Player;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.EnumSet;
+import java.util.List;
+import java.util.Set;
+import java.util.UUID;
+import java.util.stream.Collectors;
+
+/**
+ * 805.4d: with shared team turns (rule 805), a step or phase of the team's turn is each of its
+ * players' step or phase. The game fires the beginning of a step once, for the player who holds the
+ * team's turn; triggered abilities are also checked against this event for each of the active team's
+ * other players (TriggeredAbilities, DelayedTriggeredAbilities). While such an event is checked, and
+ * while an ability it triggered is put on the stack and resolves, that player is the active player
+ * for the ability (805.9, Game.asActivePlayer).
+ */
+public class TeamStepEvent extends GameEvent {
+
+    /** The events that begin a step or a phase. */
+    private static final Set<EventType> STEP_STARTS = Arrays.stream(EventType.values())
+            .filter(type -> type.name().endsWith("_STEP_PRE") || type.name().endsWith("_PHASE_PRE"))
+            .collect(Collectors.toCollection(() -> EnumSet.noneOf(EventType.class)));
+
+    public TeamStepEvent(GameEvent event, UUID playerId) {
+        super(event.getType(), event.getTargetId(), null, playerId);
+    }
+
+    /**
+     * The given event and, when it begins a step or phase of a team's turn, that step for each of the
+     * active team's other players still in the game. Just the event outside team games.
+     */
+    public static List<GameEvent> withTeamSteps(GameEvent event, Game game) {
+        List<GameEvent> events = new ArrayList<>(1);
+        events.add(event);
+        if (!STEP_STARTS.contains(event.getType())) {
+            return events;
+        }
+        UUID turnPlayerId = event.getPlayerId();
+        if (turnPlayerId == null || !turnPlayerId.equals(game.getState().getActivePlayerId())) {
+            return events;
+        }
+        for (UUID teammateId : game.getTeammates(turnPlayerId)) {
+            Player teammate = game.getPlayer(teammateId);
+            if (teammate != null && teammate.isInGame()) {
+                events.add(new TeamStepEvent(event, teammateId));
+            }
+        }
+        return events;
+    }
+}

diff --git a/Mage/src/main/java/mage/abilities/keyword/OptionalAdditionalManaCostAbility.java b/Mage/src/main/java/mage/abilities/keyword/OptionalAdditionalManaCostAbility.java
new file mode 100644
index 00000000..812c8073
--- /dev/null
+++ b/Mage/src/main/java/mage/abilities/keyword/OptionalAdditionalManaCostAbility.java
@@ -0,0 +1,98 @@
+package mage.abilities.keyword;
+
+import mage.abilities.Ability;
+import mage.abilities.SpellAbility;
+import mage.abilities.StaticAbility;
+import mage.abilities.costs.OptionalAdditionalSourceCosts;
+import mage.abilities.costs.mana.ManaCostsImpl;
+import mage.constants.Outcome;
+import mage.constants.Zone;
+import mage.game.Game;
+import mage.players.Player;
+import mage.util.CardUtil;
+
+/**
+ * "As an additional cost to cast this spell, you may pay {cost}" and "... you may pay {cost} any
+ * number of times": an optional additional mana cost that is not a kicker, as older cards print it
+ * (Undergrowth, Taste of Paradise; Commander Duels, XMage patch 0014). Unlike kicker, a spell cast
+ * this way is not kicked. The times the cost was paid are kept in the spell's costs tags under the
+ * ability's key: {@link #timesPaid(Game, Ability, String)}.
+ */
+public class OptionalAdditionalManaCostAbility extends StaticAbility implements OptionalAdditionalSourceCosts {
+
+    private final String key;
+    private final String manaString;
+    private final boolean repeatable;
+    private final String rule;
+
+    /**
+     * @param key        the costs tag the times paid are kept under, unique to the card
+     * @param manaString the cost, e.g. "{2}{R}"
+     * @param repeatable whether it may be paid any number of times
+     */
+    public OptionalAdditionalManaCostAbility(String key, String manaString, boolean repeatable) {
+        super(Zone.STACK, null);
+        this.key = key;
+        this.manaString = manaString;
+        this.repeatable = repeatable;
+        this.rule = "As an additional cost to cast this spell, you may pay " + manaString
+                + (repeatable ? " any number of times." : ".");
+        this.setRuleAtTheTop(true);
+    }
+
+    protected OptionalAdditionalManaCostAbility(final OptionalAdditionalManaCostAbility ability) {
+        super(ability);
+        this.key = ability.key;
+        this.manaString = ability.manaString;
+        this.repeatable = ability.repeatable;
+        this.rule = ability.rule;
+    }
+
+    @Override
+    public OptionalAdditionalManaCostAbility copy() {
+        return new OptionalAdditionalManaCostAbility(this);
+    }
+
+    @Override
+    public void addOptionalAdditionalCosts(Ability ability, Game game) {
+        if (!(ability instanceof SpellAbility)) {
+            return;
+        }
+        Player player = game.getPlayer(ability.getControllerId());
+        if (player == null) {
+            return;
+        }
+        int paid = 0;
+        while (player.canRespond()) {
+            ManaCostsImpl<?> cost = new ManaCostsImpl<>(manaString);
+            String times = repeatable ? (paid + 1) + (paid == 0 ? " time" : " times") + " " : "";
+            if (!cost.canPay(ability, this, ability.getControllerId(), game)
+                    || !player.chooseUse(Outcome.AIDontUseIt, "Pay " + times + manaString + "?", ability, game)) {
+                break;
+            }
+            ability.addManaCostsToPay(cost);
+            paid++;
+            ability.setCostsTag(key, paid);
+            if (!repeatable) {
+                break;
+            }
+        }
+    }
+
+    @Override
+    public String getCastMessageSuffix() {
+        return "";
+    }
+
+    @Override
+    public String getRule() {
+        return rule;
+    }
+
+    /**
+     * How many times the spell's controller paid the optional cost as it was cast (0 if never).
+     */
+    public static int timesPaid(Game game, Ability source, String key) {
+        return CardUtil.getSourceCostsTag(game, source, key, 0);
+    }
+}

+    /**
+     * Commander Duels: how many of a triggered ability's options a simulation tries. The real game
+     * does not take the trigger's targets from the simulation (see the TODO above), which scores
+     * the line that sets the trigger off: a sample of the options is enough for that.
+     */
+    public static final int MAX_TRIGGER_OPTIONS = 12;
+
+    /** At most {@code limit} of the options, evenly spread over the list, in its order. */
+    static <T> List<T> spreadOver(List<T> options, int limit) {
+        if (options.size() <= limit) {
+            return options;
+        }
+        List<T> spread = new ArrayList<>(limit);
+        for (int i = 0; i < limit; i++) {
+            spread.add(options.get((int) ((long) i * options.size() / limit)));
+        }
+        return spread;
+    }

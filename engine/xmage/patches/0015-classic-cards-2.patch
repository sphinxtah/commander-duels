+package mage.cards.a;
+
+import mage.MageObjectReference;
+import mage.abilities.Ability;
+import mage.abilities.common.ActivateIfConditionActivatedAbility;
+import mage.abilities.common.delayed.AtTheBeginOfNextEndStepDelayedTriggeredAbility;
+import mage.abilities.condition.common.BeforeAttackersAreDeclaredCondition;
+import mage.abilities.costs.common.TapSourceCost;
+import mage.abilities.costs.mana.GenericManaCost;
+import mage.abilities.effects.OneShotEffect;
+import mage.abilities.effects.common.combat.AttacksIfAbleTargetEffect;
+import mage.cards.CardImpl;
+import mage.cards.CardSetInfo;
+import mage.constants.CardType;
+import mage.constants.Duration;
+import mage.constants.Outcome;
+import mage.constants.SubType;
+import mage.filter.common.FilterCreaturePermanent;
+import mage.filter.predicate.Predicate;
+import mage.filter.predicate.Predicates;
+import mage.game.Game;
+import mage.game.permanent.Permanent;
+import mage.players.Player;
+import mage.target.TargetPermanent;
+import mage.target.targetpointer.FixedTarget;
+import mage.watchers.common.AttackedThisTurnWatcher;
+
+import java.util.UUID;
+
+/**
+ * Arcum's Whistle (Ice Age), as printed. Commander Duels patch 0015.
+ */
+public final class ArcumsWhistle extends CardImpl {
+
+    private static final FilterCreaturePermanent filter = new FilterCreaturePermanent(
+            "non-Wall creature the active player has controlled continuously since the beginning of the turn");
+
+    static {
+        filter.add(Predicates.not(SubType.WALL.getPredicate()));
+        filter.add((Predicate<Permanent>) (permanent, game) ->
+                permanent.isControlledBy(game.getActivePlayerId())
+                        && permanent.wasControlledFromStartOfControllerTurn());
+    }
+
+    public ArcumsWhistle(UUID ownerId, CardSetInfo setInfo) {
+        super(ownerId, setInfo, new CardType[]{CardType.ARTIFACT}, "{3}");
+
+        // {3}, {T}: Choose target non-Wall creature the active player has controlled continuously since the beginning of the turn. That player may pay {X}, where X is that creature's mana value. If they don't, the creature attacks this turn if able, and at the beginning of the next end step, destroy it if it didn't attack. Activate only before attackers are declared.
+        Ability ability = new ActivateIfConditionActivatedAbility(
+                new ArcumsWhistleEffect(), new GenericManaCost(3), BeforeAttackersAreDeclaredCondition.instance);
+        ability.addCost(new TapSourceCost());
+        ability.addTarget(new TargetPermanent(filter));
+        ability.addWatcher(new AttackedThisTurnWatcher());
+        this.addAbility(ability);
+    }
+
+    private ArcumsWhistle(final ArcumsWhistle card) {
+        super(card);
+    }
+
+    @Override
+    public ArcumsWhistle copy() {
+        return new ArcumsWhistle(this);
+    }
+}
+
+class ArcumsWhistleEffect extends OneShotEffect {
+
+    ArcumsWhistleEffect() {
+        super(Outcome.Detriment);
+        staticText = "Choose target non-Wall creature the active player has controlled continuously since the beginning "
+                + "of the turn. That player may pay {X}, where X is that creature's mana value. If they don't, the "
+                + "creature attacks this turn if able, and at the beginning of the next end step, destroy it if it didn't attack";
+    }
+
+    private ArcumsWhistleEffect(final ArcumsWhistleEffect effect) {
+        super(effect);
+    }
+
+    @Override
+    public ArcumsWhistleEffect copy() {
+        return new ArcumsWhistleEffect(this);
+    }
+
+    @Override
+    public boolean apply(Game game, Ability source) {
+        Permanent creature = game.getPermanent(getTargetPointer().getFirst(game, source));
+        if (creature == null) {
+            return false;
+        }
+        Player player = game.getPlayer(creature.getControllerId());
+        if (player == null) {
+            return false;
+        }
+        GenericManaCost cost = new GenericManaCost(creature.getManaValue());
+        if (cost.canPay(source, source, player.getId(), game)
+                && player.chooseUse(Outcome.Benefit, "Pay {" + creature.getManaValue() + "} so that "
+                + creature.getLogName() + " need not attack?", source, game)
+                && cost.pay(source, game, source, player.getId(), false)) {
+            return true;
+        }
+        game.addEffect(new AttacksIfAbleTargetEffect(Duration.EndOfTurn)
+                .setTargetPointer(new FixedTarget(creature, game)), source);
+        game.addDelayedTriggeredAbility(new AtTheBeginOfNextEndStepDelayedTriggeredAbility(
+                new ArcumsWhistleDestroyEffect(new MageObjectReference(creature, game))), source);
+        return true;
+    }
+}
+
+class ArcumsWhistleDestroyEffect extends OneShotEffect {
+
+    private final MageObjectReference creature;
+
+    ArcumsWhistleDestroyEffect(MageObjectReference creature) {
+        super(Outcome.DestroyPermanent);
+        this.creature = creature;
+        staticText = "destroy it if it didn't attack";
+    }
+
+    private ArcumsWhistleDestroyEffect(final ArcumsWhistleDestroyEffect effect) {
+        super(effect);
+        this.creature = effect.creature;
+    }
+
+    @Override
+    public ArcumsWhistleDestroyEffect copy() {
+        return new ArcumsWhistleDestroyEffect(this);
+    }
+
+    @Override
+    public boolean apply(Game game, Ability source) {
+        Permanent permanent = creature.getPermanent(game);
+        if (permanent == null) {
+            return false;
+        }
+        AttackedThisTurnWatcher watcher = game.getState().getWatcher(AttackedThisTurnWatcher.class);
+        if (watcher != null && watcher.getAttackedThisTurnCreatures().contains(creature)) {
+            return false;
+        }
+        return permanent.destroy(source, game, false);
+    }
+}
diff --git a/Mage.Sets/src/mage/cards/b/Backdraft.java b/Mage.Sets/src/mage/cards/b/Backdraft.java
new file mode 100644
index 00000000..8cfe1e71
--- /dev/null
+++ b/Mage.Sets/src/mage/cards/b/Backdraft.java
@@ -0,0 +1,163 @@
+package mage.cards.b;
+
+import mage.abilities.Ability;
+import mage.abilities.effects.OneShotEffect;
+import mage.cards.CardImpl;
+import mage.cards.CardSetInfo;
+import mage.choices.Choice;
+import mage.choices.ChoiceImpl;
+import mage.constants.CardType;
+import mage.constants.Outcome;
+import mage.constants.WatcherScope;
+import mage.game.Game;
+import mage.game.events.GameEvent;
+import mage.game.stack.Spell;
+import mage.players.Player;
+import mage.target.TargetPlayer;
+import mage.filter.FilterPlayer;
+import mage.filter.predicate.Predicate;
+import mage.watchers.Watcher;
+
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.UUID;
+
+/**
+ * Backdraft (Legends), as printed. Commander Duels patch 0015.
+ * <p>
+ * The damage a sorcery spell dealt this turn is counted per spell, to players and permanents alike;
+ * the player chosen is one who cast a sorcery spell this turn that dealt damage.
+ */
+public final class Backdraft extends CardImpl {
+
+    public Backdraft(UUID ownerId, CardSetInfo setInfo) {
+        super(ownerId, setInfo, new CardType[]{CardType.INSTANT}, "{1}{R}");
+
+        // Choose a player who cast one or more sorcery spells this turn. Backdraft deals damage to that player equal to half the damage dealt by one of those sorcery spells this turn, rounded down.
+        this.getSpellAbility().addEffect(new BackdraftEffect());
+        this.getSpellAbility().addWatcher(new BackdraftWatcher());
+    }
+
+    private Backdraft(final Backdraft card) {
+        super(card);
+    }
+
+    @Override
+    public Backdraft copy() {
+        return new Backdraft(this);
+    }
+}
+
+class BackdraftEffect extends OneShotEffect {
+
+    BackdraftEffect() {
+        super(Outcome.Damage);
+        staticText = "Choose a player who cast one or more sorcery spells this turn. {this} deals damage to that player "
+                + "equal to half the damage dealt by one of those sorcery spells this turn, rounded down";
+    }
+
+    private BackdraftEffect(final BackdraftEffect effect) {
+        super(effect);
+    }
+
+    @Override
+    public BackdraftEffect copy() {
+        return new BackdraftEffect(this);
+    }
+
+    @Override
+    public boolean apply(Game game, Ability source) {
+        Player controller = game.getPlayer(source.getControllerId());
+        BackdraftWatcher watcher = game.getState().getWatcher(BackdraftWatcher.class);
+        if (controller == null || watcher == null || watcher.casters().isEmpty()) {
+            return false;
+        }
+        FilterPlayer filter = new FilterPlayer("a player who cast one or more sorcery spells this turn");
+        filter.add((Predicate<Player>) (player, g) -> watcher.casters().contains(player.getId()));
+        TargetPlayer target = new TargetPlayer(1, 1, true, filter);
+        controller.choose(Outcome.Damage, target, source, game);
+        Player chosen = game.getPlayer(target.getFirstTarget());
+        if (chosen == null) {
+            return false;
+        }
+        Map<String, Integer> spells = new LinkedHashMap<>();
+        watcher.damageBy(chosen.getId()).forEach((spell, damage) -> spells.put(spell, damage));
+        int damage = 0;
+        if (spells.size() == 1) {
+            damage = spells.values().iterator().next();
+        } else if (spells.size() > 1) {
+            Choice choice = new ChoiceImpl(true);
+            choice.setMessage("Choose one of those sorcery spells");
+            choice.setChoices(spells.keySet());
+            if (controller.choose(Outcome.Damage, choice, game) && choice.getChoice() != null) {
+                damage = spells.get(choice.getChoice());
+            } else {
+                damage = spells.values().stream().max(Integer::compare).orElse(0);
+            }
+        }
+        if (damage / 2 > 0) {
+            chosen.damage(damage / 2, source.getSourceId(), source, game);
+        }
+        return true;
+    }
+}
+
+/** The sorcery spells cast this turn by each player, with the damage each dealt. */
+class BackdraftWatcher extends Watcher {
+
+    private final Map<UUID, Map<UUID, Integer>> damage = new HashMap<>();
+    private final Map<UUID, String> names = new HashMap<>();
+
+    BackdraftWatcher() {
+        super(WatcherScope.GAME);
+    }
+
+    @Override
+    public void watch(GameEvent event, Game game) {
+        if (event.getType() == GameEvent.EventType.SPELL_CAST) {
+            Spell spell = game.getSpell(event.getTargetId());
+            if (spell != null && spell.isSorcery(game)) {
+                damage.computeIfAbsent(spell.getControllerId(), k -> new LinkedHashMap<>())
+                        .putIfAbsent(spell.getId(), 0);
+                names.put(spell.getId(), spell.getName());
+            }
+            return;
+        }
+        if (event.getType() != GameEvent.EventType.DAMAGED_PLAYER
+                && event.getType() != GameEvent.EventType.DAMAGED_PERMANENT) {
+            return;
+        }
+        Spell spell = game.getSpellOrLKIStack(event.getSourceId());
+        if (spell == null || !spell.isSorcery(game)) {
+            return;
+        }
+        Map<UUID, Integer> spells = damage.get(spell.getControllerId());
+        if (spells != null && spells.containsKey(spell.getId())) {
+            spells.merge(spell.getId(), event.getAmount(), Integer::sum);
+        }
+    }
+
+    @Override
+    public void reset() {
+        super.reset();
+        damage.clear();
+        names.clear();
+    }
+
+    java.util.Set<UUID> casters() {
+        return damage.keySet();
+    }
+
+    /** Each of the player's sorcery spells this turn, by a label naming it, with the damage it dealt. */
+    Map<String, Integer> damageBy(UUID playerId) {
+        Map<String, Integer> found = new LinkedHashMap<>();
+        int index = 1;
+        for (Map.Entry<UUID, Integer> entry : damage.getOrDefault(playerId, new HashMap<>()).entrySet()) {
+            String label = index++ + ". " + names.getOrDefault(entry.getKey(), "a sorcery spell")
+                    + " (" + entry.getValue() + " damage)";
+            found.put(label, entry.getValue());
+        }
+        return found;
+    }
+}
diff --git a/Mage.Sets/src/mage/cards/e/Equinox.java b/Mage.Sets/src/mage/cards/e/Equinox.java

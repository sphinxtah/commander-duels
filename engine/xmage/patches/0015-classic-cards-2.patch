@@ -0,0 +1,107 @@
+package mage.cards.e;
+
+import mage.abilities.Ability;
+import mage.abilities.Mode;
+import mage.abilities.common.SimpleActivatedAbility;
+import mage.abilities.common.SimpleStaticAbility;
+import mage.abilities.costs.common.TapSourceCost;
+import mage.abilities.effects.Effect;
+import mage.abilities.effects.common.AttachEffect;
+import mage.abilities.effects.common.CounterTargetEffect;
+import mage.abilities.effects.common.DestroyAllEffect;
+import mage.abilities.effects.common.DestroyTargetEffect;
+import mage.abilities.effects.common.continuous.GainAbilityAttachedEffect;
+import mage.abilities.keyword.EnchantAbility;
+import mage.cards.CardImpl;
+import mage.cards.CardSetInfo;
+import mage.constants.AttachmentType;
+import mage.constants.CardType;
+import mage.constants.Outcome;
+import mage.constants.SubType;
+import mage.filter.FilterSpell;
+import mage.filter.predicate.ObjectSourcePlayer;
+import mage.filter.predicate.ObjectSourcePlayerPredicate;
+import mage.game.Game;
+import mage.game.permanent.Permanent;
+import mage.game.stack.Spell;
+import mage.target.TargetPermanent;
+import mage.target.TargetSpell;
+import mage.target.common.TargetLandPermanent;
+
+import java.util.UUID;
+
+/**
+ * Equinox (Legends), as printed. Commander Duels patch 0015.
+ * <p>
+ * A spell "would destroy a land you control" when one of its modes destroys a target that is a
+ * land you control, or destroys all permanents of a kind among which is a land you control.
+ */
+public final class Equinox extends CardImpl {
+
+    private static final FilterSpell filter = new FilterSpell("spell if it would destroy a land you control");
+
+    static {
+        filter.add(EquinoxPredicate.instance);
+    }
+
+    public Equinox(UUID ownerId, CardSetInfo setInfo) {
+        super(ownerId, setInfo, new CardType[]{CardType.ENCHANTMENT}, "{W}");
+        this.subtype.add(SubType.AURA);
+
+        // Enchant land
+        TargetPermanent auraTarget = new TargetLandPermanent();
+        this.getSpellAbility().addTarget(auraTarget);
+        this.getSpellAbility().addEffect(new AttachEffect(Outcome.AddAbility));
+        this.addAbility(new EnchantAbility(auraTarget));
+
+        // Enchanted land has "{T}: Counter target spell if it would destroy a land you control."
+        Ability ability = new SimpleActivatedAbility(new CounterTargetEffect(), new TapSourceCost());
+        ability.addTarget(new TargetSpell(filter));
+        Effect effect = new GainAbilityAttachedEffect(ability, AttachmentType.AURA);
+        effect.setText("Enchanted land has \"{T}: Counter target spell if it would destroy a land you control.\"");
+        this.addAbility(new SimpleStaticAbility(effect));
+    }
+
+    private Equinox(final Equinox card) {
+        super(card);
+    }
+
+    @Override
+    public Equinox copy() {
+        return new Equinox(this);
+    }
+}
+
+enum EquinoxPredicate implements ObjectSourcePlayerPredicate<Spell> {
+    instance;
+
+    @Override
+    public boolean apply(ObjectSourcePlayer<Spell> input, Game game) {
+        Spell spell = input.getObject();
+        UUID you = input.getPlayerId();
+        for (Mode mode : spell.getSpellAbility().getModes().getSelectedModes().stream()
+                .map(id -> spell.getSpellAbility().getModes().get(id)).toList()) {
+            for (Effect effect : mode.getEffects()) {
+                if (effect instanceof DestroyTargetEffect) {
+                    boolean hits = mode.getTargets().stream()
+                            .flatMap(target -> target.getTargets().stream())
+                            .map(game::getPermanent)
+                            .anyMatch(permanent -> permanent != null && permanent.isLand(game)
+                                    && permanent.isControlledBy(you));
+                    if (hits) {
+                        return true;
+                    }
+                }
+                if (effect instanceof DestroyAllEffect) {
+                    DestroyAllEffect all = (DestroyAllEffect) effect;
+                    for (Permanent land : game.getBattlefield().getAllActivePermanents(you)) {
+                        if (land.isLand(game) && all.getText(mode).toLowerCase().contains("land")) {
+                            return true;
+                        }
+                    }
+                }
+            }
+        }
+        return false;
+    }
+}

new file mode 100644
index 00000000..8859a1a2
--- /dev/null
+++ b/Mage.Sets/src/mage/cards/o/OgreEnforcer.java
@@ -0,0 +1,131 @@
+package mage.cards.o;
+
+import mage.MageInt;
+import mage.MageObjectReference;
+import mage.abilities.Ability;
+import mage.abilities.common.SimpleStaticAbility;
+import mage.abilities.effects.ReplacementEffectImpl;
+import mage.cards.CardImpl;
+import mage.cards.CardSetInfo;
+import mage.constants.CardType;
+import mage.constants.Duration;
+import mage.constants.Outcome;
+import mage.constants.SubType;
+import mage.constants.WatcherScope;
+import mage.game.Game;
+import mage.game.events.GameEvent;
+import mage.game.permanent.Permanent;
+import mage.watchers.Watcher;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.UUID;
+
+/**
+ * Ogre Enforcer (Visions), as printed. Commander Duels patch 0015.
+ * <p>
+ * The damage marked on it is counted per source for the turn (damage wears off in the cleanup
+ * step); lethal damage with deathtouch counts as lethal damage from its source.
+ */
+public final class OgreEnforcer extends CardImpl {
+
+    public OgreEnforcer(UUID ownerId, CardSetInfo setInfo) {
+        super(ownerId, setInfo, new CardType[]{CardType.CREATURE}, "{3}{R}{R}");
+        this.subtype.add(SubType.OGRE);
+        this.power = new MageInt(4);
+        this.toughness = new MageInt(4);
+
+        // Ogre Enforcer can't be destroyed by lethal damage unless lethal damage dealt by a single source is marked on it.
+        Ability ability = new SimpleStaticAbility(new OgreEnforcerEffect());
+        ability.addWatcher(new OgreEnforcerWatcher());
+        this.addAbility(ability);
+    }
+
+    private OgreEnforcer(final OgreEnforcer card) {
+        super(card);
+    }
+
+    @Override
+    public OgreEnforcer copy() {
+        return new OgreEnforcer(this);
+    }
+}
+
+class OgreEnforcerEffect extends ReplacementEffectImpl {
+
+    OgreEnforcerEffect() {
+        super(Duration.WhileOnBattlefield, Outcome.Benefit);
+        staticText = "{this} can't be destroyed by lethal damage unless lethal damage dealt by a single source is marked on it";
+    }
+
+    private OgreEnforcerEffect(final OgreEnforcerEffect effect) {
+        super(effect);
+    }
+
+    @Override
+    public OgreEnforcerEffect copy() {
+        return new OgreEnforcerEffect(this);
+    }
+
+    @Override
+    public boolean checksEventType(GameEvent event, Game game) {
+        return event.getType() == GameEvent.EventType.DESTROY_PERMANENT;
+    }
+
+    @Override
+    public boolean applies(GameEvent event, Ability source, Game game) {
+        // The state-based action for lethal damage destroys with no source.
+        if (!event.getTargetId().equals(source.getSourceId()) || event.getSourceId() != null) {
+            return false;
+        }
+        Permanent ogre = game.getPermanent(source.getSourceId());
+        if (ogre == null || ogre.isDeathtouched()) {
+            return false;
+        }
+        int toughness = ogre.getToughness().getValue();
+        if (toughness <= 0 || ogre.getDamage() < toughness) {
+            return false;
+        }
+        OgreEnforcerWatcher watcher = game.getState().getWatcher(OgreEnforcerWatcher.class);
+        return watcher == null || watcher.mostFromOneSource(new MageObjectReference(ogre, game)) < toughness;
+    }
+
+    @Override
+    public boolean replaceEvent(GameEvent event, Ability source, Game game) {
+        return true;
+    }
+}
+
+/** Damage dealt to each permanent this turn, by source. */
+class OgreEnforcerWatcher extends Watcher {
+
+    private final Map<MageObjectReference, Map<UUID, Integer>> damage = new HashMap<>();
+
+    OgreEnforcerWatcher() {
+        super(WatcherScope.GAME);
+    }
+
+    @Override
+    public void watch(GameEvent event, Game game) {
+        if (event.getType() != GameEvent.EventType.DAMAGED_PERMANENT) {
+            return;
+        }
+        Permanent permanent = game.getPermanent(event.getTargetId());
+        if (permanent == null) {
+            return;
+        }
+        damage.computeIfAbsent(new MageObjectReference(permanent, game), k -> new HashMap<>())
+                .merge(event.getSourceId(), event.getAmount(), Integer::sum);
+    }
+
+    @Override
+    public void reset() {
+        super.reset();
+        damage.clear();
+    }
+
+    int mostFromOneSource(MageObjectReference permanent) {
+        return damage.getOrDefault(permanent, new HashMap<>()).values().stream()
+                .mapToInt(Integer::intValue).max().orElse(0);
+    }
+}

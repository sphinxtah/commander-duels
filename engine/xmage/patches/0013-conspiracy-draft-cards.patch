diff --git a/Mage.Sets/src/mage/cards/g/GrenzosRebuttal.java b/Mage.Sets/src/mage/cards/g/GrenzosRebuttal.java
new file mode 100644
index 00000000..a4494eba
--- /dev/null
+++ b/Mage.Sets/src/mage/cards/g/GrenzosRebuttal.java
@@ -0,0 +1,123 @@
+package mage.cards.g;
+
+import mage.abilities.Ability;
+import mage.abilities.effects.OneShotEffect;
+import mage.abilities.effects.common.CreateTokenEffect;
+import mage.cards.CardImpl;
+import mage.cards.CardSetInfo;
+import mage.constants.CardType;
+import mage.constants.Outcome;
+import mage.constants.SubType;
+import mage.filter.FilterPermanent;
+import mage.filter.common.FilterArtifactPermanent;
+import mage.filter.common.FilterCreaturePermanent;
+import mage.filter.common.FilterLandPermanent;
+import mage.filter.predicate.permanent.ControllerIdPredicate;
+import mage.game.Game;
+import mage.game.permanent.Permanent;
+import mage.game.permanent.token.custom.CreatureToken;
+import mage.players.Player;
+import mage.players.PlayerList;
+import mage.target.TargetPermanent;
+
+import java.util.ArrayList;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.UUID;
+
+/**
+ * Grenzo's Rebuttal (Commander Duels, XMage patch 0013).
+ */
+public final class GrenzosRebuttal extends CardImpl {
+
+    public GrenzosRebuttal(UUID ownerId, CardSetInfo setInfo) {
+        super(ownerId, setInfo, new CardType[]{CardType.SORCERY}, "{4}{R}{R}");
+
+        // Create a 4/4 red Ogre creature token.
+        this.getSpellAbility().addEffect(new CreateTokenEffect(
+                new CreatureToken(4, 4, "4/4 red Ogre creature token", SubType.OGRE)
+                        .withName("Ogre Token")
+                        .withColor("R")));
+        // Starting with you, each player chooses an artifact, a creature, and a land from among the
+        // permanents controlled by the player to their left. Destroy each permanent chosen this way.
+        this.getSpellAbility().addEffect(new GrenzosRebuttalEffect());
+    }
+
+    private GrenzosRebuttal(final GrenzosRebuttal card) {
+        super(card);
+    }
+
+    @Override
+    public GrenzosRebuttal copy() {
+        return new GrenzosRebuttal(this);
+    }
+}
+
+class GrenzosRebuttalEffect extends OneShotEffect {
+
+    GrenzosRebuttalEffect() {
+        super(Outcome.DestroyPermanent);
+        staticText = "Starting with you, each player chooses an artifact, a creature, and a land from among "
+                + "the permanents controlled by the player to their left. Destroy each permanent chosen this way";
+    }
+
+    private GrenzosRebuttalEffect(final GrenzosRebuttalEffect effect) {
+        super(effect);
+    }
+
+    @Override
+    public GrenzosRebuttalEffect copy() {
+        return new GrenzosRebuttalEffect(this);
+    }
+
+    @Override
+    public boolean apply(Game game, Ability source) {
+        Player controller = game.getPlayer(source.getControllerId());
+        if (controller == null) {
+            return false;
+        }
+        // The players in turn order, starting with you. The player to a player's left is the next one
+        // in turn order, or the one before it while the turn order is reversed.
+        PlayerList players = game.getState().getPlayersInRange(controller.getId(), game, true);
+        if (!players.setCurrent(controller.getId())) {
+            return false;
+        }
+        List<UUID> order = new ArrayList<>();
+        order.add(controller.getId());
+        for (int i = 1; i < players.size(); i++) {
+            order.add(game.isTurnOrderReversed() ? players.getPrevious() : players.getNext());
+        }
+        Set<UUID> chosen = new LinkedHashSet<>();
+        for (int i = 0; i < order.size(); i++) {
+            Player chooser = game.getPlayer(order.get(i));
+            Player left = game.getPlayer(order.get((i + 1) % order.size()));
+            if (chooser == null || left == null || order.size() < 2) {
+                continue;
+            }
+            for (FilterPermanent filter : new FilterPermanent[]{
+                    new FilterArtifactPermanent("artifact controlled by " + left.getName()),
+                    new FilterCreaturePermanent("creature controlled by " + left.getName()),
+                    new FilterLandPermanent("land controlled by " + left.getName())}) {
+                filter.add(new ControllerIdPredicate(left.getId()));
+                TargetPermanent target = new TargetPermanent(1, 1, filter, true);
+                if (!target.canChoose(chooser.getId(), source, game)) {
+                    continue;
+                }
+                chooser.choose(Outcome.DestroyPermanent, target, source, game);
+                Permanent permanent = game.getPermanent(target.getFirstTarget());
+                if (permanent != null) {
+                    chosen.add(permanent.getId());
+                    game.informPlayers(chooser.getLogName() + " chooses " + permanent.getLogName());
+                }
+            }
+        }
+        for (UUID permanentId : chosen) {
+            Permanent permanent = game.getPermanent(permanentId);
+            if (permanent != null) {
+                permanent.destroy(source, game, false);
+            }
+        }
+        return true;
+    }
+}

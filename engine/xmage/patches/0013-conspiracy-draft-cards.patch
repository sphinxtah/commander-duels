Conspiracy's draft-matters cards, played as printed outside a draft (Commander Duels v0.9.4).

Reason: Commander Duels deals these cards from Conspiracy and Conspiracy: Take the Crown packs, but
it has no draft, and XMage had no implementation of them, so they played as stand-ins. Outside a
draft nothing is noted, revealed, chosen or removed as the cards are drafted, and by the cards'
rulings their other abilities then do nothing: a noted number is 0 (Lurking Automaton, Pyretic
Hunter and Cogwork Grinder enter with no counters, Garbage Fire deals 0 damage, Custodi
Peacekeeper taps a creature with power 0 or less), no color was chosen (Regicide has no legal
target, Paliano, the High City adds no mana), and no name, type or card was noted (Aether Searcher
and Smuggler Captain may search and find nothing, then shuffle). The draft text is kept as printed
(XMage's InfoEffect, as Agent of Acquisitions already does upstream). Grenzo's Rebuttal has no draft
ability and plays in full: the player to a player's left is the next in turn order, or the one
before it while the turn order is reversed (XMage's PlayersLeftRightHint). 18 card classes and the
two sets' card lists; Spy Kit ("has all names of nonlegendary creature cards") is not here.
Upstream: none.
Remove when: XMage implements these cards.
diff --git a/Mage.Sets/src/mage/cards/a/AetherSearcher.java b/Mage.Sets/src/mage/cards/a/AetherSearcher.java
new file mode 100644
index 00000000..37018f5d
--- /dev/null
+++ b/Mage.Sets/src/mage/cards/a/AetherSearcher.java
@@ -0,0 +1,72 @@
+package mage.cards.a;
+
+import java.util.UUID;
+import mage.MageInt;
+import mage.MageObject;
+import mage.abilities.Ability;
+import mage.abilities.common.EntersBattlefieldTriggeredAbility;
+import mage.abilities.common.SimpleStaticAbility;
+import mage.abilities.effects.common.InfoEffect;
+import mage.abilities.effects.common.search.SearchLibraryPutInHandEffect;
+import mage.cards.CardImpl;
+import mage.cards.CardSetInfo;
+import mage.constants.CardType;
+import mage.constants.SubType;
+import mage.constants.Zone;
+import mage.filter.FilterCard;
+import mage.filter.predicate.Predicate;
+import mage.game.Game;
+import mage.target.common.TargetCardInLibrary;
+
+/**
+ * Aether Searcher (Commander Duels, XMage patch 0013).
+ *
+ * Draft abilities: Commander Duels has no draft, so nothing is ever noted, revealed or
+ * removed as these cards are drafted. By the cards' rulings their other abilities then do
+ * nothing (a noted number is 0, and no name, color or card was noted). The draft text
+ * still shows, as printed.
+ */
+public final class AetherSearcher extends CardImpl {
+
+    public AetherSearcher(UUID ownerId, CardSetInfo setInfo) {
+        super(ownerId, setInfo, new CardType[]{CardType.ARTIFACT, CardType.CREATURE}, "{7}");
+        this.subtype.add(SubType.CONSTRUCT);
+        this.power = new MageInt(6);
+        this.toughness = new MageInt(4);
+
+        this.addAbility(new SimpleStaticAbility(Zone.ALL, new InfoEffect("Reveal this card as you draft it. Reveal the next card you draft and note its name.")));
+        // Nothing was noted, so the search finds no card; a search of the library still shuffles it.
+        FilterCard filter = new FilterCard();
+        filter.add(NothingNotedPredicate.instance);
+        Ability ability = new EntersBattlefieldTriggeredAbility(
+                new SearchLibraryPutInHandEffect(new TargetCardInLibrary(filter), true)
+                        .setText("you may search your hand and/or library for a card with a name noted as you drafted cards named Aether Searcher. You may cast it without paying its mana cost. If you search your library this way, shuffle"), true);
+        this.addAbility(ability);
+    }
+
+    private AetherSearcher(final AetherSearcher card) {
+        super(card);
+    }
+
+    @Override
+    public AetherSearcher copy() {
+        return new AetherSearcher(this);
+    }
+}
+
+/**
+ * Nothing was noted as this card was drafted, so no card matches.
+ */
+enum NothingNotedPredicate implements Predicate<MageObject> {
+    instance;
+
+    @Override
+    public boolean apply(MageObject input, Game game) {
+        return false;
+    }
+
+    @Override
+    public String toString() {
+        return "Nothing noted";
+    }
+}

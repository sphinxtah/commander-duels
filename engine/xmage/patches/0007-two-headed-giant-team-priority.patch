+    /**
+     * 805.7: with shared team turns, the members of a team put all triggered abilities any of them
+     * controls on the stack in any order they choose. Abilities that don't use the stack are
+     * handled first, as for one player. Of several, the team's chooser (805.2, getTeamChooser)
+     * picks the one that goes on the stack next, from all the team's, and its controller puts it
+     * there, making its choices.
+     */
+    private boolean checkTeamTriggered(UUID playerId) {
+        boolean played = false;
+        List<UUID> team = new ArrayList<>(getTeam(playerId));
+        while (team.stream().map(this::getPlayer).anyMatch(player -> player != null && player.canRespond())) {
+            List<TriggeredAbility> abilities = new ArrayList<>();
+            for (UUID teamPlayerId : team) {
+                Player teamPlayer = getPlayer(teamPlayerId);
+                if (teamPlayer != null && teamPlayer.canRespond()) {
+                    abilities.addAll(state.getTriggered(teamPlayerId));
+                }
+            }
+            if (abilities.isEmpty()) {
+                break;
+            }
+            TriggeredAbility next = abilities.stream().filter(ability -> !ability.isUsesStack()).findFirst()
+                    .orElse(null);

# The live site's settings: /srv/commander-duels/.env on the VM (commanderduels), mode 600.
# bootstrap-vm.sh writes it once and generates the two secrets on the VM; they never leave it.
# deploy.sh keeps CD_VERSION at the image tag that is running.
CD_VERSION=
CD_PUBLIC_URL=https://duels.thesphinx.co
# A Web OAuth client ID with https://duels.thesphinx.co as an authorized JavaScript origin. Public.
CD_GOOGLE_CLIENT_ID=
# approval: SysOp approves every new account (until the site opens to the public at v1.0.0).
CD_SIGNUP_POLICY=approval
# The TSH nginx proxy's LAN address, as this VM sees it.
CD_PROXY_ADDRESS=10.10.50.2
# Where SysOp may sign in from: the home LAN. Never the proxy's network.
CD_SYSOP_NETWORKS=10.10.1.0/24
CD_GAMES_PER_ACCOUNT=1
# Games at once, in the API and the engine (1-8); the engine's heap holds eight.
CD_GAMES_MAX=6
CD_DB_PASSWORD=__GENERATED__
CD_ENGINE_SERVICE_TOKEN=__GENERATED__

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:commander-duels:engine-seat-view:v1",
  "title": "EngineSeatSnapshot",
  "description": "What the engine's development game endpoint (GET /v1/games/{id}/view) returns to one seat, or to a spectator: the authorized view, the open prompt and the public log. Built field by field; every object is closed, so the contract cannot carry another player's hand (but a Two-Headed Giant teammate's, since v0.5.0), library contents, another seat's deck, XMage identifiers or the shuffle seed. Object ids are opaque and change when an object changes zones. Tables seat two to four players. A spectator's snapshot has no seat, no prompt and no \"you\", and shows public information only, possibly delayed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["game_id", "revision", "status", "seat", "settings", "prompt", "view", "result", "log_count", "log_from", "log"],
  "properties": {
    "game_id": {"type": "string", "format": "uuid"},
    "revision": {"type": "integer", "minimum": 0},
    "status": {
      "enum": ["starting", "your_prompt", "unsupported_prompt", "waiting", "eliminated", "spectating", "finished"]
    },
    "seat": {"$ref": "#/$defs/nullableSeat"},
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "rules_profile", "seats", "skill", "turn_cap", "idle_timeout_seconds", "spectator_delay_seconds"],
      "properties": {
        "format": {"enum": ["legacy", "commander", "two_headed_giant"]},
        "rules_profile": {"enum": ["legacy_two_player_duel", "commander_two_seat", "commander_free_for_all", "two_headed_giant_legacy"]},
        "seats": {
          "description": "Every seat in turn order. A seat sees only its own deck; other seats' decks are null.",
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seat", "player", "deck"],
            "properties": {
              "seat": {"$ref": "#/$defs/seat"},
              "player": {"enum": ["human", "bot"]},
              "deck": {"$ref": "#/$defs/nullableString"}
            }
          }
        },
        "skill": {"type": "integer", "minimum": 1, "maximum": 6},
        "turn_cap": {"type": "integer", "minimum": 1, "maximum": 200},
        "idle_timeout_seconds": {"type": "integer", "minimum": 5, "maximum": 3600},
        "spectator_delay_seconds": {"type": "integer", "minimum": 0, "maximum": 300}
      }
    },
    "prompt": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/prompt"}]},
    "view": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/view"}]},
    "result": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/result"}]},
    "log_count": {"type": "integer", "minimum": 0},
    "log_from": {"type": "integer", "minimum": 0},
    "log": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/logLine"}}
  },
  "allOf": [
    {
      "if": {"properties": {"seat": {"type": "null"}}},
      "then": {
        "description": "A spectator: no prompt, and a view with no you, hand, looked-at cards or messages.",
        "properties": {
          "prompt": {"type": "null"},
          "view": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "properties": {
                  "you": {"type": "null"},
                  "hand": {"maxItems": 0},
                  "looked_at": {"maxItems": 0},
                  "messages": {"maxItems": 0},
                  "priority": {"type": "null"}
                }
              }
            ]
          }
        }
      }
    },
    {
      "description": "Two-Headed Giant (since v0.5.0): a seat sees its teammate's hand (810.5, FMT10), so one opponent at most carries one. Every other game, and every spectator, shows no player's hand. A seat's own hand is the view's hand.",
      "if": {
        "properties": {
          "seat": {"not": {"type": "null"}},
          "settings": {"properties": {"format": {"const": "two_headed_giant"}}}
        }
      },
      "then": {
        "properties": {
          "view": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "properties": {
                  "you": {"oneOf": [{"type": "null"}, {"type": "object", "properties": {"hand": {"type": "null"}}}]},
                  "opponents": {
                    "contains": {"type": "object", "required": ["hand"], "properties": {"hand": {"type": "array"}}},
                    "minContains": 0,
                    "maxContains": 1
                  }
                }
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "view": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "properties": {
                  "you": {"oneOf": [{"type": "null"}, {"type": "object", "properties": {"hand": {"type": "null"}}}]},
                  "opponents": {"items": {"properties": {"hand": {"type": "null"}}}}
                }
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "seat": {"type": "integer", "minimum": 0, "maximum": 3},
    "objectId": {"type": "string", "pattern": "^o[0-9a-f]{16}$"},
    "nullableString": {"type": ["string", "null"]},
    "nullableSeat": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/seat"}]},
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "message", "detail", "options", "amounts", "piles", "xmage_query"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "kind": {
          "enum": ["priority", "mulligan", "yes_no", "choose_target", "choose_defender", "choose_ability", "choose_choice", "choose_name", "choose_mode", "choose_amount", "order_triggers", "choose_pile", "pay_mana", "declare_attackers", "declare_blockers", "assign_amounts", "unsupported"]
        },
        "message": {"type": "string"},
        "detail": {"$ref": "#/$defs/nullableString"},
        "options": {"type": "array", "items": {"$ref": "#/$defs/option"}},
        "amounts": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/amounts"}]},
        "piles": {
          "description": "For choose_pile: each pile's objects the seat may see.",
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "array", "items": {"$ref": "#/$defs/objectId"}}
            }
          ]
        },
        "xmage_query": {"$ref": "#/$defs/nullableString"}
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "label", "object_id", "seat", "selected"],
      "properties": {
        "id": {"type": "string", "pattern": "^[0-9]{1,16}$"},
        "action": {
          "enum": ["pass", "pass_until_stack_resolved", "pass_until_next_main", "pass_until_end_of_turn", "pass_until_next_turn", "pass_until_end_step_before_my_turn", "pass_until_my_turn", "cast", "play_land", "activate", "activate_mana", "mulligan", "keep", "yes", "no", "choose", "done", "tap_source", "use_pool", "special_payment", "cancel", "toggle_attacker", "all_attack", "toggle_blocker", "suggested", "use_ability", "choose_mode", "put_first", "choose_pile"]
        },
        "label": {"$ref": "#/$defs/nullableString"},
        "object_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/objectId"}]},
        "seat": {"$ref": "#/$defs/nullableSeat"},
        "selected": {"type": "boolean"}
      }
    },
    "amounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_min", "total_max", "entries"],
      "properties": {
        "total_min": {"type": "integer"},
        "total_max": {"type": "integer"},
        "entries": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "min", "max", "suggested"],
            "properties": {
              "label": {"type": "string"},
              "min": {"type": "integer"},
              "max": {"type": "integer"},
              "suggested": {"type": "integer"}
            }
          }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seat", "turn", "active_seat", "priority_seat", "phase", "step", "you", "opponents", "hand", "battlefield", "stack", "combat", "revealed", "looked_at", "messages", "priority"],
      "properties": {
        "seat": {"$ref": "#/$defs/nullableSeat"},
        "turn": {"type": "integer", "minimum": 0},
        "active_seat": {"$ref": "#/$defs/nullableSeat"},
        "priority_seat": {"$ref": "#/$defs/nullableSeat"},
        "phase": {"$ref": "#/$defs/nullableString"},
        "step": {"$ref": "#/$defs/nullableString"},
        "you": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/player"}]},
        "opponents": {
          "description": "Every other player in seat order, including eliminated ones; for a spectator, every player.",
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/player"}
        },
        "hand": {"type": "array", "items": {"$ref": "#/$defs/card"}},
        "battlefield": {"type": "array", "items": {"$ref": "#/$defs/permanent"}},
        "stack": {"type": "array", "items": {"$ref": "#/$defs/stackItem"}},
        "combat": {"type": "array", "items": {"$ref": "#/$defs/combat"}},
        "revealed": {"type": "array", "items": {"$ref": "#/$defs/cardGroup"}},
        "looked_at": {"type": "array", "items": {"$ref": "#/$defs/cardGroup"}},
        "messages": {"type": "array", "maxItems": 10, "items": {"type": "string"}},
        "priority": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/priorityControls"}]}
      }
    },
    "priorityControls": {
      "description": "The seat's priority controls (UI07): how it is passing now, and where it stops. Null for spectators.",
      "type": "object",
      "additionalProperties": false,
      "required": ["passing", "your_turn", "opponent_turn", "stop_on_new_stack_objects", "stop_on_attackers", "stop_on_blockers", "pass_after_casting", "full_control"],
      "properties": {
        "passing": {"enum": [null, "until_stack_resolved", "until_next_main", "until_end_of_turn", "until_next_turn", "until_end_step_before_my_turn", "until_my_turn"]},
        "your_turn": {"type": "array", "maxItems": 7, "items": {"enum": ["upkeep", "draw", "main1", "before_combat", "end_of_combat", "main2", "end_of_turn"]}},
        "opponent_turn": {"type": "array", "maxItems": 7, "items": {"enum": ["upkeep", "draw", "main1", "before_combat", "end_of_combat", "main2", "end_of_turn"]}},
        "stop_on_new_stack_objects": {"type": "boolean"},
        "stop_on_attackers": {"type": "boolean"},
        "stop_on_blockers": {"type": "boolean"},
        "pass_after_casting": {"type": "boolean"},
        "full_control": {"type": "boolean"}
      }
    },
    "player": {
      "description": "A player's public state. The hand and library appear only as counts, except that in Two-Headed Giant (since v0.5.0) a player's hand is shown to their teammate. Commander fields are null or empty outside Commander.",
      "type": "object",
      "additionalProperties": false,
      "required": ["seat", "name", "life", "counters", "library_count", "hand_count", "graveyard", "exile", "mana_pool", "lost", "won", "color_identity", "command_zone", "commanders"],
      "properties": {
        "seat": {"$ref": "#/$defs/seat"},
        "name": {"type": "string"},
        "team": {
          "description": "Two-Headed Giant (since v0.5.0): 0 for seats 0 and 1, 1 for seats 2 and 3; teammates share one life total, so both show the team's. Null in other games.",
          "oneOf": [{"type": "null"}, {"enum": [0, 1]}]
        },
        "life": {"type": "integer"},
        "counters": {"$ref": "#/$defs/counts"},
        "library_count": {"type": "integer", "minimum": 0},
        "hand_count": {"type": "integer", "minimum": 0},
        "hand": {
          "description": "The player's hand, shown only to their teammate in Two-Headed Giant (810.5, FMT10); null for everyone else.",
          "oneOf": [{"type": "null"}, {"type": "array", "items": {"$ref": "#/$defs/card"}}]
        },
        "graveyard": {"type": "array", "items": {"$ref": "#/$defs/card"}},
        "exile": {"type": "array", "items": {"$ref": "#/$defs/card"}},
        "mana_pool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["white", "blue", "black", "red", "green", "colorless"],
          "properties": {
            "white": {"type": "integer", "minimum": 0},
            "blue": {"type": "integer", "minimum": 0},
            "black": {"type": "integer", "minimum": 0},
            "red": {"type": "integer", "minimum": 0},
            "green": {"type": "integer", "minimum": 0},
            "colorless": {"type": "integer", "minimum": 0}
          }
        },
        "lost": {"type": "boolean"},
        "won": {"type": "boolean"},
        "color_identity": {
          "description": "The combined colour identity of the player's commanders, in WUBRG order; null outside Commander.",
          "oneOf": [{"type": "null"}, {"type": "string", "pattern": "^W?U?B?R?G?$"}]
        },
        "command_zone": {"type": "array", "items": {"$ref": "#/$defs/card"}},
        "commanders": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/commander"}}
      }
    },
    "commander": {
      "description": "One commander (FMT01). Its identity is public; its object id appears only while the seat can see it, and a commander in a hand or library is 'hidden' to everyone but its owner.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "zone", "object_id", "cast_count", "tax", "damage_dealt"],
      "properties": {
        "name": {"type": "string"},
        "zone": {
          "enum": ["command", "battlefield", "stack", "graveyard", "exile", "hand", "library", "hidden", "outside"]
        },
        "object_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/objectId"}]},
        "cast_count": {"type": "integer", "minimum": 0},
        "tax": {"type": "integer", "minimum": 0, "multipleOf": 2},
        "damage_dealt": {
          "description": "Combat damage this commander has dealt to each player, by seat; 21 from one commander is lethal.",
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seat", "damage"],
            "properties": {"seat": {"$ref": "#/$defs/seat"}, "damage": {"type": "integer", "minimum": 1}}
          }
        }
      },
      "if": {"properties": {"zone": {"enum": ["hidden", "outside"]}}},
      "then": {"properties": {"object_id": {"type": "null"}}}
    },
    "card": {
      "description": "A card face. A hidden card (face down, for instance) carries its id and nothing else.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "hidden", "name", "mana_cost", "type_line", "power", "toughness", "rules"],
      "properties": {
        "id": {"$ref": "#/$defs/objectId"},
        "hidden": {"type": "boolean"},
        "name": {"$ref": "#/$defs/nullableString"},
        "mana_cost": {"$ref": "#/$defs/nullableString"},
        "type_line": {"$ref": "#/$defs/nullableString"},
        "power": {"$ref": "#/$defs/nullableString"},
        "toughness": {"$ref": "#/$defs/nullableString"},
        "rules": {"type": "array", "items": {"type": "string"}}
      },
      "if": {"properties": {"hidden": {"const": true}}},
      "then": {
        "properties": {
          "name": {"type": "null"},
          "mana_cost": {"type": "null"},
          "type_line": {"type": "null"},
          "power": {"type": "null"},
          "toughness": {"type": "null"},
          "rules": {"maxItems": 0}
        }
      }
    },
    "permanent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "controller_seat", "owner_seat", "card", "tapped", "summoning_sick", "damage", "counters", "attacking", "blocking", "attached_to"],
      "properties": {
        "id": {"$ref": "#/$defs/objectId"},
        "controller_seat": {"$ref": "#/$defs/seat"},
        "owner_seat": {"$ref": "#/$defs/seat"},
        "card": {"$ref": "#/$defs/card"},
        "tapped": {"type": "boolean"},
        "summoning_sick": {"type": "boolean"},
        "damage": {"type": "integer", "minimum": 0},
        "counters": {"$ref": "#/$defs/counts"},
        "attacking": {"type": "boolean"},
        "blocking": {"type": "boolean"},
        "attached_to": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/objectId"}]}
      }
    },
    "stackItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "controller_seat", "name", "text", "hidden", "targets"],
      "properties": {
        "id": {"$ref": "#/$defs/objectId"},
        "kind": {"enum": ["spell", "ability"]},
        "controller_seat": {"$ref": "#/$defs/seat"},
        "name": {"$ref": "#/$defs/nullableString"},
        "text": {"$ref": "#/$defs/nullableString"},
        "hidden": {"type": "boolean"},
        "targets": {"type": "array", "items": {"$ref": "#/$defs/target"}}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "seat", "object_id", "label"],
      "properties": {
        "kind": {"enum": ["player", "object"]},
        "seat": {"$ref": "#/$defs/nullableSeat"},
        "object_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/objectId"}]},
        "label": {"$ref": "#/$defs/nullableString"}
      }
    },
    "combat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attackers", "defender", "blockers", "blocked"],
      "properties": {
        "attackers": {"type": "array", "items": {"$ref": "#/$defs/objectId"}},
        "defender": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/target"}]},
        "blockers": {"type": "array", "items": {"$ref": "#/$defs/objectId"}},
        "blocked": {"type": "boolean"}
      }
    },
    "cardGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "cards"],
      "properties": {"name": {"type": "string"}, "cards": {"type": "array", "items": {"$ref": "#/$defs/card"}}}
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "winner_seat", "draw", "conceded_seats", "turns", "error"],
      "properties": {
        "kind": {"enum": ["completed", "turn_limit", "closed", "idle_timeout", "humans_eliminated", "error"]},
        "winner_seat": {"$ref": "#/$defs/nullableSeat"},
        "winner_seats": {
          "description": "Every winning seat (since v0.5.0): the winner, or in Two-Headed Giant the winning team; empty without a winner.",
          "type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/seat"}
        },
        "draw": {"type": "boolean"},
        "conceded_seats": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/seat"}},
        "turns": {"type": "integer", "minimum": 0},
        "error": {"$ref": "#/$defs/nullableString"}
      }
    },
    "logLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "turn", "active_seat", "step", "text"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "turn": {"type": "integer", "minimum": 0},
        "active_seat": {"$ref": "#/$defs/nullableSeat"},
        "step": {"$ref": "#/$defs/nullableString"},
        "text": {"type": "string"}
      }
    }
  }
}

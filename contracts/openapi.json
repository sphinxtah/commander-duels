            "title": "Status",
            "type": "string"
          },
          "version": {
            "default": "0.0.3",
            "title": "Version",
            "type": "string"
          }
        },
        "title": "Health",
        "type": "object"
      },
      "Readiness": {
        "additionalProperties": false,
        "properties": {
          "database": {
            "enum": [
              "ready",
              "unavailable",
              "migration_required"
            ],
            "title": "Database",
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "Readiness",
        "type": "object"
      },
      "XmageBuild": {
        "additionalProperties": false,
        "properties": {
          "commit": {
            "title": "Commit",
            "type": "string"
          },
          "commit_date": {
            "title": "Commit Date",
            "type": "string"
          },
          "tag": {
            "title": "Tag",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "tag",
          "commit",
          "commit_date"
        ],
        "title": "XmageBuild",
        "type": "object"
      }
    }
  },

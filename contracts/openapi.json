            "const": 1,
            "default": 1,
            "title": "Protocol Version",
            "type": "integer"
          },
          "status": {
            "enum": [
              "unavailable",
              "loading",
              "ready",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "xmage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/XmageBuild"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "status"
        ],
        "title": "EngineStatus",
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "Error",
        "type": "object"
      },
      "Format": {
        "additionalProperties": false,
        "properties": {
          "available": {
            "default": false,
            "title": "Available",
            "type": "boolean"
          },
          "default_seats": {
            "title": "Default Seats",
            "type": "integer"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "enum": [
              "commander",
              "legacy",
              "two_headed_giant"
            ],
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "seats": {
            "items": {
              "type": "integer"
            },
            "title": "Seats",
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "seats",
          "default_seats",
          "description"
        ],
        "title": "Format",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",

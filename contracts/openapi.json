{
  "components": {
    "schemas": {
      "Bootstrap": {
        "additionalProperties": false,
        "properties": {
          "capabilities": {
            "items": {
              "$ref": "#/components/schemas/Capability"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "collection_policy": {
            "const": "open_collection",
            "default": "open_collection",
            "title": "Collection Policy",
            "type": "string"
          },
          "name": {
            "const": "Commander Duels",
            "default": "Commander Duels",
            "title": "Name",
            "type": "string"
          },
          "protocol_version": {
            "const": 1,
            "default": 1,
            "title": "Protocol Version",
            "type": "integer"
          },
          "version": {
            "default": "0.0.3",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "capabilities"
        ],
        "title": "Bootstrap",
        "type": "object"
      },
      "Capability": {
        "additionalProperties": false,
        "properties": {
          "available": {
            "default": false,
            "title": "Available",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "milestone": {
            "title": "Milestone",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }

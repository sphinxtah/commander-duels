            "title": "Printings",
            "type": "integer"
          }
        },
        "required": [
          "printings",
          "distinct_names"
        ],
        "title": "CardCounts",
        "type": "object"
      },
      "EngineStatus": {
        "additionalProperties": false,
        "description": "Engine /health, passed through. \"unavailable\" means the engine is unreachable or invalid.",
        "properties": {
          "bot_match_enabled": {
            "default": false,
            "title": "Bot Match Enabled",
            "type": "boolean"
          },
          "cards": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CardCounts"
              },
              {
                "type": "null"
              }
            ]

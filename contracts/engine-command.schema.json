{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:commander-duels:engine-command:v1",
  "title": "EngineCommand",
  "description": "Internal adapter envelope. The engine's development game endpoints accept submit_choice and concede from a seat; the other operations remain unimplemented. Authentication, authorization and controller lease are server context, never client-selected seats: the engine selects the seat from its seat token.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "game_id", "action_id", "expected_revision", "type", "payload"],
  "properties": {
    "v": {"const": 1},
    "game_id": {"type": "string", "format": "uuid"},
    "action_id": {"type": "string", "format": "uuid"},
    "expected_revision": {"type": "integer", "minimum": 0},
    "prompt_id": {"type": "string", "format": "uuid"},
    "type": {"enum": ["create_game", "submit_choice", "get_authorized_view", "checkpoint", "restore", "advance_bot", "validate_deck", "close_game", "concede"]},
    "payload": {"type": "object", "maxProperties": 32}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "submit_choice"}}},
      "then": {"required": ["prompt_id"], "properties": {"payload": {"$ref": "#/$defs/choice"}}}
    },
    {
      "if": {"properties": {"type": {"const": "concede"}}},
      "then": {"properties": {"payload": {"type": "object", "maxProperties": 0}}}
    }
  ],
  "$defs": {
    "choice": {
      "description": "Exactly one option id from the open prompt, or one amount per entry of an assign_amounts prompt.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "option_id": {"type": "string", "minLength": 1, "maxLength": 16},
        "amounts": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "integer", "minimum": 0, "maximum": 10000}}
      },
      "oneOf": [{"required": ["option_id"]}, {"required": ["amounts"]}]
    }
  }
}
